# Hedera EVM testnet (chain 296)
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296

# Deployed FaceValueBond. See README "Deployed contract".
FACEVALUE_BOND_ADDRESS=0xa5201c0c7252354b485637eec562ba4ed149bf86

# Deployer key. TESTNET ONLY — never commit a funded key.
DEPLOYER_PRIVATE_KEY=

# Role holders for contracts/script/Deploy.s.sol
#
# WARNING: these addresses were derived as keccak256("matcher") etc., so their
# private keys are genuinely public — anyone can recompute them. That is fine for
# a testnet demo, and it is why they are convenient: they are recoverable and
# nobody has to hand over a real key. It is NOT a security property. If this ever
# moves past a demo, generate real keys and grant the roles to those instead.
MATCHER_ADDRESS=0x79Bd056c0b2fab71728887d2952Ad5B13823B985
RESOLVER_1=0xAA7056beA1d21A15b36Ce69f649DF41269379EF2
RESOLVER_2=0xff41CA88776e79bAcaf505Ad976b61276dC15F6e
RESOLVER_3=0x5918DF3FB876E687Cc27A2227f440c380D89cBfD

# Also exposed to the browser so bonds can be posted from the user's wallet.
NEXT_PUBLIC_FACEVALUE_BOND_ADDRESS=0xa5201c0c7252354b485637eec562ba4ed149bf86

# Switch on-chain settlement. Bonds are always signed client-side; this gates
# whether the server also settles tier-1 results on-chain.
ONCHAIN_SETTLEMENT=false

# Bond per side, in HBAR. Small on purpose — this is a testnet demo.
DEMO_BOND_HBAR=0.01

# World ID. Without these the app says "simulated" everywhere.
WORLDID_RP_ID=
WORLDID_RP_SIGNING_KEY=
